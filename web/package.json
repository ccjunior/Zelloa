{
  "name": "zelloa",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:family && npm run build:school",
    "watch": "ng build --watch --configuration development",
    "test": "ng test zelloa-family --watch=false && ng test zelloa-school --watch=false && ng test api-client --watch=false && ng test authentication --watch=false && ng test shared-ui --watch=false && ng test utilities --watch=false",
    "lint": "ng lint zelloa-family && ng lint zelloa-school && ng lint api-client && ng lint authentication && ng lint shared-ui && ng lint utilities",
    "build:family": "ng build zelloa-family --configuration production",
    "build:school": "ng build zelloa-school --configuration production"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
