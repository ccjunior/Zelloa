# Local development only. Coolify values must be configured separately as secrets.
ZELLOA_POSTGRES_DB=zelloa
ZELLOA_POSTGRES_USER=zelloa
ZELLOA_POSTGRES_PASSWORD=zelloa-local

ZELLOA_FAMILY_URL=http://localhost:8081
ZELLOA_SCHOOL_URL=http://localhost:8082
ZELLOA_ADMIN_URL=http://localhost:8083

# Leave empty after the first PlatformAdmin has been created.
ZELLOA_BOOTSTRAP_ADMIN_EMAIL=
ZELLOA_BOOTSTRAP_ADMIN_PASSWORD=
